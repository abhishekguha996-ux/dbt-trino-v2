FROM rust:1.96.0-bookworm@sha256:05f85ef6eb0f2600ac62e9d779642b5b362d5be2ed67b80e162fae6e28b66524

# Only OS tools are installed here. No dbt/dependency build runs in BuildKit.
# Debian package signatures are checked; resolved versions are recorded below.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv cmake clang lld pkg-config libssl-dev protobuf-compiler libprotobuf-dev \
    && mkdir -p /opt/lab /workspace \
    && dpkg-query -W > /opt/lab/os-packages.txt \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 lab \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /workspace/home lab \
    && chown 10001:10001 /workspace

RUN rustup component add rustfmt --toolchain 1.96.0-aarch64-unknown-linux-gnu

COPY sources.lock.json Cargo.lock /opt/lab/
COPY --chown=10001:10001 .inputs/ /opt/lab/inputs/
COPY scripts/*.py /opt/lab/
COPY projects/ /opt/lab/projects/

USER 10001:10001
WORKDIR /workspace
ENV HOME=/workspace/home \
    CARGO_HOME=/workspace/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    RUSTUP_TOOLCHAIN=1.96.0-aarch64-unknown-linux-gnu \
    CARGO_BUILD_JOBS=1 \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_DEV_DEBUG=0 \
    CARGO_PROFILE_TEST_DEBUG=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DBT_SEND_ANONYMOUS_USAGE_STATS=false
ENTRYPOINT ["python3", "/opt/lab/container.py"]
